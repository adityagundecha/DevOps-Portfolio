---
import { site } from '../data/site';

const highlights = [
  { value: '12+', label: 'Years in platform & DevOps' },
  { value: '20', label: 'Engineers in the team I lead' },
  { value: '70+', label: 'Engineers mentored' },
  { value: '$1.5M', label: 'Annual cloud savings' },
];
---

<section class="hero" id="top">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{site.title}</p>
      <h1 class="hero-name">
        {site.name}
      </h1>
      <p class="hero-tagline">{site.tagline}</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#projects">View my work</a>
        <a class="btn btn-ghost" href={site.cv} download>Download CV</a>
      </div>

      <dl class="hero-stats">
        {
          highlights.map((h) => (
            <div class="stat">
              <dt class="stat-value">{h.value}</dt>
              <dd class="stat-label">{h.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hero-photo-wrap">
      <span class="hero-frame" aria-hidden="true"></span>
      <img
        class="hero-photo"
        src={site.photo}
        width="320"
        height="320"
        alt={`Portrait of ${site.name}`}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      46rem 40rem at 82% -15%,
      var(--accent-soft),
      transparent 62%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .hero-name {
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    font-weight: 450;
    margin-bottom: 1.25rem;
  }

  .hero-tagline {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 38ch;
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 3rem;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem clamp(1.5rem, 4vw, 3rem);
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .stat-value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.7rem, 3.5vw, 2.3rem);
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--text-faint);
    margin-top: 0.3rem;
    max-width: 16ch;
  }

  .hero-photo-wrap {
    position: relative;
    justify-self: center;
    width: min(330px, 74vw);
    aspect-ratio: 1;
  }

  .hero-frame {
    position: absolute;
    inset: 0;
    transform: translate(1.1rem, 1.1rem);
    border: 1px solid var(--accent);
    border-radius: 3px;
    opacity: 0.55;
    pointer-events: none;
  }

  .hero-photo {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 3px;
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow);
  }

  @media (max-width: 820px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .hero-photo-wrap {
      order: -1;
      justify-self: start;
      width: min(230px, 52vw);
    }
  }
</style>
