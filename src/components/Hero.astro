---
import { site } from '../data/site';

const highlights = [
  { value: '12+', label: 'Years in platform & DevOps' },
  { value: '20', label: 'Engineers in the team I lead' },
  { value: '70+', label: 'Engineers mentored' },
  { value: '$1.5M', label: 'Annual cloud savings' },
];
---

<section class="hero" id="top">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{site.title}</p>
      <h1 class="hero-name">
        Hi, I'm {site.name}.
      </h1>
      <p class="hero-tagline">{site.tagline}</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#projects">View my work</a>
        <a class="btn btn-ghost" href={site.cv} download>Download CV</a>
      </div>

      <dl class="hero-stats">
        {
          highlights.map((h) => (
            <div class="stat">
              <dt class="stat-value">{h.value}</dt>
              <dd class="stat-label">{h.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hero-photo-wrap">
      <div class="hero-glow" aria-hidden="true"></div>
      <img
        class="hero-photo"
        src={site.photo}
        width="320"
        height="320"
        alt={`Portrait of ${site.name}`}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        42rem 42rem at 78% -10%,
        var(--accent-soft),
        transparent 60%
      );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .hero-name {
    font-size: clamp(2.5rem, 7vw, 4.4rem);
    margin-bottom: 1.1rem;
  }

  .hero-tagline {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    color: var(--text-muted);
    max-width: 34ch;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 2.75rem;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .stat-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    margin-top: 0.2rem;
  }

  .hero-photo-wrap {
    position: relative;
    justify-self: center;
    width: min(320px, 72vw);
    aspect-ratio: 1;
  }

  .hero-glow {
    position: absolute;
    inset: -12%;
    border-radius: 50%;
    background: conic-gradient(
      from 140deg,
      var(--accent),
      transparent 45%,
      var(--accent-strong) 85%,
      var(--accent)
    );
    filter: blur(34px);
    opacity: 0.45;
    animation: spin 18s linear infinite;
  }

  .hero-photo {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 24px;
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 820px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .hero-photo-wrap {
      order: -1;
      justify-self: start;
      width: min(220px, 50vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow {
      animation: none;
    }
  }
</style>
